CONFIG_ENV=config.env

# ============================================================
#  Mi 11 Lite 5G (renoir / SM7350) + KernelSU 非GKI 编译配置
#  内核：5.4.233-qgki  系统：MIUI14 / Android13
# ============================================================

# ---------- 内核源码 ----------
# ★ 用 A13 分支：内核 5.4.233，与你手机 5.4.233-qgki 完全一致
#   (downstream 分支是 5.4.210，较旧，不推荐)
KERNEL_SOURCE=https://github.com/Official-Ayrton990/android_kernel_xiaomi_renoir
KERNEL_SOURCE_BRANCH=A13

# ★★★ 关键：不再用 vendor/renoir-qgki_defconfig，改用从原厂 boot.img 里
# 抽出来的【真实完整 .config】。
#
# 原因：vendor/renoir-qgki_defconfig 只是基础 defconfig，原厂实际编译时
# 还叠加了其它片段（LTO / CFI / ShadowCallStack 等）。实测对比：
#
#   原厂 CONFIG_LTO=y / THINLTO=y / LTO_CLANG=y / CFI_CLANG=y / SHADOW_CALL_STACK=y
#   基础 defconfig           -> CONFIG_LTO_NONE=y（全无）
#
# 后果（若用基础 defconfig）：
#   1) SHADOW_CALL_STACK 改变寄存器 ABI（x18）-> 原厂模块必崩
#   2) CFI_CLANG 的类型哈希对不上 -> 跨模块间接调用触发 CFI trap -> panic
#   3) 大量 CONFIG 差异 -> genksyms 算出的符号 CRC 不同 -> 模块拒绝加载
#   三个里面任何一个都足以开不了机。
#
# 配置文件来源：原厂 boot.img 里的 IKCONFIG（IKCFG_ST...IKCFG_ED）
#   路径：configs/renoir_stock_kernelsu_defconfig
#   已在工作流中用步骤 “Install stock kernel config” 拷入内核源码树
KERNEL_CONFIG=renoir_stock_kernelsu_defconfig

# 产物镜像名（renoir 为 Image）
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false

# ★ LD/AR/NM/OBJCOPY/OBJDUMP/STRIP 全部指定为 LLVM 工具：
#   LTO 中间产物是 LLVM bitcode，必须用 llvm-ar / llvm-nm 处理
#   （内核对 CONFIG_LTO_CLANG 会自动设 AR:=llvm-ar / LLVM_NM:=llvm-nm，
#     但 OBJCOPY 等不会，而 Image 是用 objcopy 从 vmlinux 转出来的）
EXTRA_CMDS:LD=ld.lld AR=llvm-ar NM=llvm-nm OBJCOPY=llvm-objcopy OBJDUMP=llvm-objdump STRIP=llvm-strip KCFLAGS=-Wno-error

# ---------- Clang ----------
# ★ 必须与原厂一致：原厂 CONFIG_CC_VERSION_TEXT 显示
#     "Android (6877366 based on r383902b1) clang version 11.0.2"
#   CFI_CLANG 的跨模块类型哈希与编译器版本强相关，
#   用 clang 12 理论上可能对不上 -> CFI trap。
#   故改用 android11-release 的 clang-r383902b（同为 11.0.2 系）
USE_CUSTOM_CLANG=false
CUSTOM_CLANG_SOURCE=
CUSTOM_CLANG_BRANCH=
# ★ 留空：工作流已自动设置 CROSS_COMPILE 为下载好的 GCC 全路径。
#   若填 CLANG_TRIPLE=... 反而可能因找不到 GNU binutils 而链接报错。
CUSTOM_CMDS:

CLANG_BRANCH=android11-release
CLANG_VERSION=r383902b

# ---------- GCC 交叉编译 ----------
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ---------- KernelSU ----------
ENABLE_KERNELSU=true
# ★ 关键：非GKI 必须用 v1.0 以前的版本（官方 v1.0 起放弃非GKI支持）
KERNELSU_TAG=v0.9.5
# 留空 = 使用官方签名，配套官方 v0.9.5 管理器 APK
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ---------- 编译开关 ----------
# ★ 必须保持 false！原厂内核是 LTO+CFI+SCS，关掉就与原厂模块 ABI 不兼容。
#   （该开关对应的 sed 会把 CONFIG_LTO_CLANG 改成 n）
DISABLE-LTO=false
DISABLE_CC_WERROR=true

# defconfig 已含 KPROBES=y / MODULES=y / OVERLAY_FS=y，
# 这里保持 false 即可（true 时会重复追加，无害但不必要）
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

# ★ 先 false：kprobe 路线（自动集成）。
#   仅当刷入后卡 bootloop / 管理器不生效时才改 true（改内核源码的方式）
APPLY_KSU_PATCH=false

REMOVE_UNUSED_PACKAGES=true

# ---------- AnyKernel3 ----------
USE_CUSTOM_ANYKERNEL3=false
CUSTOM_ANYKERNEL3_SOURCE=
CUSTOM_ANYKERNEL3_BRANCH=

# ---------- 缓存 ----------
ENABLE_CCACHE=true

# ---------- DTBO ----------
# renoir 一般不需要单独刷 dtbo；若你系统需要再改 true
NEED_DTBO=false

# ---------- 是否编译完整 boot.img ----------
# ★ 建议 false：只出 AnyKernel3 卡刷包，用 TWRP/内核管理器刷入，最安全
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=
